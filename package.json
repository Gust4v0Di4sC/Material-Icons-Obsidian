{
  "name": "material-icons-obsidian",
  "version": "1.0.2",
  "description": "Material Theme Icons for Obsidian file explorer",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit && node esbuild.config.mjs production",
    "lint": "eslint .",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "material-icons"
  ],
  "author": "Gustavo Dias",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gust4v0Di4sC/Material-Icons-Obsidian.git"
  },
  "bugs": {
    "url": "https://github.com/Gust4v0Di4sC/Material-Icons-Obsidian/issues"
  },
  "homepage": "https://github.com/Gust4v0Di4sC/Material-Icons-Obsidian#readme",
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "obsidian": "$obsidian"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.1",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "globals": "^17.13.0",
    "obsidian": "^1.14.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  }
}
